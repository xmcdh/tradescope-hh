# Durable storage is optional. Use local-json for local-only testing.
STORAGE_MODE=database
DATABASE_PROVIDER=postgres
DATABASE_SSL=require
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME

# Required for any public POST/write endpoint.
# Send this value as either:
# - Authorization: Bearer <token>
# - X-TradeScope-Token: <token>
API_WRITE_TOKEN=replace-with-a-long-random-secret

# Optional comma-separated CORS allowlist.
# The production app URL is allowed by default.
ALLOWED_ORIGINS=https://tradescope-lyart.vercel.app

# Local development fallback when you do not want durable storage.
# Paper-trading proof remains non-authoritative in this mode.
# STORAGE_MODE=local-json
