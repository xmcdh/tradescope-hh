{
  "name": "tradescope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node dev-proxy.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "backtest": "node src/scripts/runBacktest.js",
    "backtest:batch": "node src/scripts/runBacktestBatch.js",
    "backtest:report": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/generateBacktestReport.js",
    "backtest:retest-audit": "node src/scripts/generateRetestAudit.js",
    "backtest:history-comparison": "node src/scripts/generateHistoryLengthComparison.js",
    "backtest:v12-comparison": "node src/scripts/generateV12ExperimentComparison.js",
    "backtest:v13-trend-pullback-report": "node src/scripts/generateV13TrendPullbackReport.js",
    "backtest:v14-quality-filter-comparison": "node src/scripts/generateV14QualityFilterComparison.js",
    "backtest:sol-1h-forensic": "node src/scripts/generateSol1hForensicAnalysis.js",
    "backtest:sol-1h-robustness": "node src/scripts/generateSol1hRobustnessReport.js",
    "backtest:sol-1h-chop-promotion-review": "node src/scripts/generateSol1hChopPromotionReview.js",
    "backtest:sol-1h-exit-geometry": "node src/scripts/generateSol1hExitGeometryResearch.js",
    "research:v15-regime": "node src/scripts/generateSol1hV15RegimeAnalysis.js",
    "backtest:regime-audit": "node src/scripts/generateRegimeFeatureAudit.js",
    "backtest:v16-regime-comparison": "node src/scripts/generateV16RegimeFilterComparison.js",
    "backtest:v2-breakout-volume-expansion-report": "node src/scripts/generateV2BreakoutVolumeExpansionReport.js",
    "backtest:v21-breakout-funnel-comparison": "node src/scripts/generateV21BreakoutFunnelCalibrationComparison.js",
    "proof:snapshot": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/writeProofSnapshot.js",
    "paper:report": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/generatePaperReport.js",
    "paper:daily-check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/dailyPaperCheck.js",
    "paper:weekly-audit": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/weeklyPaperAudit.js",
    "db:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/checkDatabase.js",
    "test:signal": "node --test tests/signalLogic.test.js"
  },
  "dependencies": {
    "ccxt": "^4.5.51",
    "lightweight-charts": "^5.0.8",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
