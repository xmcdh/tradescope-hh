{
  "name": "tradescope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node dev-proxy.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "backtest": "node src/scripts/runBacktest.js",
    "backtest:batch": "node src/scripts/runBacktestBatch.js",
    "backtest:report": "node src/scripts/generateBacktestReport.js",
    "proof:snapshot": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/writeProofSnapshot.js",
    "paper:report": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/generatePaperReport.js",
    "paper:daily-check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/dailyPaperCheck.js",
    "paper:weekly-audit": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/weeklyPaperAudit.js",
    "db:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/checkDatabase.js",
    "test:signal": "node --test tests/signalLogic.test.js"
  },
  "dependencies": {
    "ccxt": "^4.5.51",
    "lightweight-charts": "^5.0.8",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
